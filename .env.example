# ═══════════════════════════════════════════════════════════════
#  رفيقي النفسي — متغيرات البيئة
#  انسخ هذا الملف إلى .env وعدّل القيم حسب حاجتك.
# ═══════════════════════════════════════════════════════════════

# ── قاعدة البيانات MongoDB (إلزامي في الإنتاج) ───────────────────
# محلياً:     mongodb://127.0.0.1:27017/rafiqi-nafsi
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rafiqi-nafsi
# إذا تُرك فارغاً محلياً يُستخدم الافتراضي أعلاه.
MONGODB_URI=

# ── لوحة الإدارة (إلزامي — لا يوجد افتراضي) ──────────────────────
# بدون هذا المتغير لن يعمل دخول الإدارة إطلاقاً (رسالة 503).
# اختر كلمة مرور قوية خاصة بك.
ADMIN_PASSCODE=

# ── إشعارات Web Push (VAPID) — اختياري ───────────────────────────
# إذا تُركت فارغة: يولّد الخادم المفاتيح تلقائياً عند أول إقلاع
# ويحفظها في  $DATA_DIR/vapid.json
# للتوليد اليدوي:  npx web-push generate-vapid-keys
# ملاحظة: على Railway ثبّت المفاتيح هنا أو استخدم Volume حتى
# لا تتغير عند كل إعادة نشر (تغيّر المفاتيح يُبطل الاشتراكات القديمة).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stevenhacen@gmail.com

# ── مجلد البيانات الدائمة (مفاتيح VAPID المولدة) ─────────────────
# على Railway: أنشئ Volume وثبّته على /data ثم اضبط:
#   DATA_DIR=/data
# DATA_DIR=./data

# ── المنفذ ───────────────────────────────────────────────────────
# Railway يضبط PORT تلقائياً — لا تحدده هناك.
# PORT=3000

# ── خدمة Socket.io خارجية (اختياري) ──────────────────────────────
# فارغة = المحادثة تعمل داخل نفس الخادم (الموصى به).
# NEXT_PUBLIC_SOCKET_URL=
